# ── Single image for DotInsights BE (preview/production) ───────────────────────
FROM node:16.18-slim AS builder

WORKDIR /app

# Install dependencies (devDeps needed for TypeScript build)
COPY package*.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 100000

# Copy source and build
COPY tsconfig.json ./
COPY src ./src
RUN yarn build

# ── Production image ─────────────────────────────────────────────────────────
FROM node:16.18-slim

WORKDIR /app

ENV NODE_ENV=production

# Install production dependencies only
COPY package*.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 100000 --production

# Copy built artifacts from builder stage
COPY --from=builder /app/dist ./dist

# Copy public assets (for swagger UI, etc.)
COPY src/public ./src/public

EXPOSE 3000

# Start production server
CMD ["node", "dist/server.js"]
